# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FOUNDER_NAME=Chris Ndunge
NEXT_PUBLIC_FOUNDER_TITLE=Précurseur de l'idée

# Supabase (Auth + PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (même Postgres Supabase — Prisma migrations / seed)
DATABASE_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"

# Authentication (legacy / scripts)
AUTH_SECRET=your-secret-key-min-32-chars-change-in-production

# QR Code Security
QR_SECRET=your-qr-secret-key-min-32-chars-change-in-production

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your-blob-token

# Cron Jobs
CRON_SECRET=your-cron-secret-key-min-32-chars

# Email Notifications (Resend)
RESEND_API_KEY=your-resend-api-key

# Demo Seed (only for development)
SEED_DEMO=false
